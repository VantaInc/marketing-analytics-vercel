# Server-only Google Sheets credentials. Never prefix these with NEXT_PUBLIC_.
# The service account only needs Viewer access on the catalog sheet.
GOOGLE_SERVICE_ACCOUNT_JSON_B64="base64-encoded-service-account-json"
DASHBOARD_CATALOG_SPREADSHEET_ID="google-sheet-id"
DASHBOARD_CATALOG_RANGE="Catalog!A1:L1000"

# Vanta Auth — NOT CURRENTLY USED. The app delegates access control to Vercel
# Authentication on the project; see the Access section of README.md. These are
# kept for the day the shared broker in apps/auth is deployed. VANTA_AUTH_URL
# below is a placeholder domain that does not resolve — replace it with the
# broker's real domain before setting any of these.
VANTA_AUTH_URL="https://<auth-app-domain>"
VANTA_AUTH_CLIENT_ID="marketing-directory"
VANTA_AUTH_CLIENT_SECRET="client-secret-from-auth-app-registration"
VANTA_AUTH_BYPASS_SECRET="optional-auth-app-protection-bypass-secret"
AUTH_SECRET="generate-a-long-random-string"

# Snowflake, for the offline conversion values page.
# Reads VANTA.DBT.SEED_OFFLINE_CONVERSION_VALUES. Read-only role is sufficient.
SNOWFLAKE_ACCOUNT="snowflake-account-identifier"
SNOWFLAKE_USERNAME="snowflake-username"
SNOWFLAKE_PRIVATE_KEY="rsa-private-key-pem"
SNOWFLAKE_ROLE="snowflake-role"
SNOWFLAKE_WAREHOUSE="snowflake-warehouse"
SNOWFLAKE_DATABASE="VANTA"

# Per-team catalog tabs, all in the one spreadsheet above. Both default to the
# team's real tab name, so these only need setting if a tab is renamed. Note the
# single quotes: A1 notation requires them for tab names containing spaces.
MARKETING_CATALOG_RANGE="'Marketing Catalog'!A1:Z1000"
SALES_CATALOG_RANGE="'Sales Catalog'!A1:Z1000"

