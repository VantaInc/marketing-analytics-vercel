# Snowflake credentials come from the team's shared variables — in Vercel:
# Settings → Environment Variables → Link Shared Variable. Never paste real values here.
SNOWFLAKE_ACCOUNT="snowflake-account-identifier"
SNOWFLAKE_DATABASE="snowflake-database"
SNOWFLAKE_PRIVATE_KEY="rsa-private-key-pem"
SNOWFLAKE_ROLE="snowflake-role"
SNOWFLAKE_USERNAME="snowflake-username"
SNOWFLAKE_WAREHOUSE="snowflake-warehouse"

# Dashboard renders from fixture data until campaign data exists (emails launch Aug 19).
REENGAGE_USE_FIXTURES="true"
